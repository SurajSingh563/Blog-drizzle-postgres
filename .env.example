# Local Docker Postgres — safe to commit, only works on localhost
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blog
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/blog

# Auth.js — a real secret is auto-generated on Codespace creation; this line is just a fallback placeholder
AUTH_SECRET=replace-with-a-generated-secret
AUTH_TRUST_HOST=true